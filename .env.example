# For local verification use http://localhost. For production use your domain,
# for example devflow.example.com (without https://).
SITE_ADDRESS=http://localhost
HTTP_PORT=80
HTTPS_PORT=443

MYSQL_DATABASE=devflow
MYSQL_USER=devflow
MYSQL_PASSWORD=replace-with-a-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-another-long-random-password

# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-at-least-32-random-characters
DEEPSEEK_API_KEY=

REGISTRATION_ENABLED=false
DEMO_SEED_ENABLED=true
DEMO_USERNAME=admin
DEMO_PASSWORD=replace-with-a-strong-demo-password
AI_RATE_LIMIT_PER_MINUTE=10

JAVA_OPTS=-Xms256m -Xmx1024m -XX:+UseG1GC
